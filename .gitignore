# Environment and tooling
.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
.ipynb_checkpoints/
*.ipynb
.env

# Data never enters the repo. Released split manifests are the only exception.
*.csv
*.csv.gz
*.parquet
data/
!benchmarks/manifests/*.csv.gz
# MGB IDs are small integers, so its patient hashes are reversible. Keep that manifest local until
# PhysioNet terms allow release. benchmarks/manifests/SHA256SUMS still pins it.
benchmarks/manifests/mgb.csv.gz
benchmarks/manifests/mgb2.csv.gz

# Agent instructions and the project plans stay local
CLAUDE.md
PAPER_A_PLAN.md
SAP*.md

# Results stay local except per-run summary JSON and the changelog
results/**
!results/**/
!results/**/summary.json
!results/CHANGELOG.md
